{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcp:schema:v1:checkpoint",
  "title": "PCP per-execution synchronization checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "actor_id",
    "execution_id",
    "last_event_id",
    "reconciled_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:pcp:schema:v1:common#/$defs/schemaVersion"
    },
    "checkpoint_id": {
      "$ref": "urn:pcp:schema:v1:common#/$defs/ulid"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "execution_id": {
      "$ref": "urn:pcp:schema:v1:common#/$defs/ulid"
    },
    "last_event_id": {
      "anyOf": [{ "$ref": "urn:pcp:schema:v1:common#/$defs/ulid" }, { "type": "null" }]
    },
    "reconciled_at": {
      "$ref": "urn:pcp:schema:v1:common#/$defs/dateTime"
    }
  }
}
